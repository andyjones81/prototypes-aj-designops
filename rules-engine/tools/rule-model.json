{
    "version": 2,
    "groups": [
        "Service",
        "Users and data",
        "Technology",
        "Security and assurance"
    ],
    "fields": {
        "demand": {
            "label": "Work source",
            "kind": "single",
            "group": "Service",
            "options": [
                "New demand",
                "Planned change",
                "BAU / Incident driven",
                "Feature or Improvement",
                "Risk remediation",
                "Retirement or Replacement",
                "Purchase or Procurement"
            ],
            "description": "Origin of the work; retained for compatibility with the work-category model."
        },
        "type": {
            "label": "Type of work",
            "kind": "single",
            "group": "Service",
            "options": [
                "Change",
                "New",
                "Procurement",
                "Improvement",
                "BAU"
            ],
            "description": "Work classification; procurement triggers the commercial approval rule."
        },
        "stage": {
            "label": "Stage",
            "kind": "single",
            "group": "Service",
            "options": [
                "Idea",
                "Understanding",
                "Design and test",
                "Build",
                "Run / Serve",
                "Decommissioning"
            ],
            "description": "Broad delivery stage. Discovery maps to Understanding, Alpha to Design and test, both beta phases to Build, and Live to Run / Serve."
        },
        "characteristics": {
            "label": "Characteristics",
            "kind": "multi",
            "group": "Technology",
            "options": [
                "Transactional",
                "Information",
                "Data",
                "Campaign",
                "API"
            ],
            "description": "Legacy work characteristics used by the original demo rules. Technology provides the more detailed imported-rule characteristics."
        },
        "channel": {
            "label": "Channel",
            "kind": "multi",
            "group": "Users and data",
            "options": [
                "Online",
                "Native app",
                "Face to face",
                "Print",
                "Email"
            ],
            "description": "Channels people use to access the service."
        },
        "users": {
            "label": "Users",
            "kind": "multi",
            "group": "Users and data",
            "options": [
                "SBP",
                "Public",
                "Parents and Carers",
                "Teachers",
                "Local Authorities",
                "HCPs"
            ],
            "description": "User groups; parents and carers trigger the original safeguarding review."
        },
        "transactional": {
            "label": "Transactional",
            "kind": "yesno",
            "group": "Technology",
            "options": [
                "Yes",
                "No"
            ],
            "description": "The service supports transactions or changes to records, rather than only publishing information."
        },
        "estTransactions": {
            "label": "Estimated transactions per year",
            "kind": "number",
            "group": "Technology",
            "description": "Non-negative whole number. The original high-volume assessment rule uses a threshold of 100000."
        },
        "personalData": {
            "label": "Captures or processes personal data",
            "kind": "yesno",
            "group": "Users and data",
            "options": [
                "Yes",
                "No"
            ],
            "description": "Personal information is processed, stored or transmitted, including by suppliers."
        },
        "priority": {
            "label": "Priority",
            "kind": "single",
            "group": "Security and assurance",
            "options": [
                "High",
                "Medium",
                "Low"
            ],
            "description": "Delivery priority, retained for compatibility. No current catalogue rule is gated by this field."
        },
        "risk": {
            "label": "Risk and impact",
            "kind": "single",
            "group": "Security and assurance",
            "options": [
                "High",
                "Medium",
                "Low"
            ],
            "description": "Overall risk level. The source health-check classification uses this as a prototype risk proxy."
        },
        "serviceType": {
            "label": "Service type",
            "kind": "single",
            "group": "Service",
            "options": [
                "Digital service",
                "Data service",
                "Technology platform",
                "Corporate system"
            ],
            "description": "The service or system being assessed. All imported requirements are scoped to these service types."
        },
        "deliveryModel": {
            "label": "Delivery model",
            "kind": "single",
            "group": "Service",
            "options": [
                "In-house",
                "Supplier managed",
                "Hybrid"
            ],
            "description": "Who builds and operates the service. Supplier-managed hosting does not remove legal or assurance obligations."
        },
        "changeType": {
            "label": "Change scope",
            "kind": "single",
            "group": "Service",
            "options": [
                "New service",
                "Major change",
                "Minor change",
                "Retirement",
                "No change"
            ],
            "description": "The scope of the proposed work, distinct from its current delivery stage."
        },
        "deliveryPhase": {
            "label": "Assessment phase",
            "kind": "single",
            "group": "Service",
            "options": [
                "Discovery",
                "Alpha",
                "Private beta",
                "Public beta",
                "Live"
            ],
            "description": "The exact assessment being booked; private and public beta share the broader Build stage."
        },
        "hasUsers": {
            "label": "Has human users",
            "kind": "yesno",
            "group": "Users and data",
            "options": [
                "Yes",
                "No"
            ],
            "description": "Whether people use an interface or user journey, rather than only machine-to-machine automation."
        },
        "dataTypes": {
            "label": "Information types",
            "kind": "multi",
            "group": "Users and data",
            "options": [
                "Financial",
                "Sensitive",
                "Intellectual property",
                "Business critical",
                "Stateful"
            ],
            "description": "Types of information processed, stored or transmitted. Personal data is supplied separately as personalData."
        },
        "processesInformation": {
            "label": "Processes information",
            "kind": "yesno",
            "group": "Users and data",
            "options": [
                "Yes",
                "No"
            ],
            "description": "Processes, stores or transmits information, including non-personal information."
        },
        "externalDataSharing": {
            "label": "Shares data with other organisations",
            "kind": "yesno",
            "group": "Users and data",
            "options": [
                "Yes",
                "No"
            ],
            "description": "Information crosses an organisational boundary."
        },
        "offshoreData": {
            "label": "Data outside UK / EEA",
            "kind": "yesno",
            "group": "Users and data",
            "options": [
                "Yes",
                "No"
            ],
            "description": "Data is stored or processed outside the UK / EEA, including by suppliers. EEA near-shore hosting is not treated as offshore here."
        },
        "publicFacing": {
            "label": "Internet accessible",
            "kind": "yesno",
            "group": "Technology",
            "options": [
                "Yes",
                "No"
            ],
            "description": "The service can be reached from the public internet."
        },
        "technology": {
            "label": "Technology in use",
            "kind": "multi",
            "group": "Technology",
            "options": [
                "Web application",
                "API",
                "Cloud hosting",
                "Cloud storage",
                "Containers",
                "Compute / runtimes",
                "Source repository",
                "CI/CD",
                "Data repositories",
                "Collaboration tools",
                "Corporate devices",
                "Management interfaces",
                "Legacy authentication",
                "Third-party products",
                "System integration",
                "Foundation systems"
            ],
            "description": "Technology actually used by the service; select all that apply."
        },
        "customDevelopment": {
            "label": "Custom software development",
            "kind": "yesno",
            "group": "Technology",
            "options": [
                "Yes",
                "No"
            ],
            "description": "The team or its supplier builds or changes custom code, rather than only consuming a packaged SaaS product."
        },
        "softwareLicensing": {
            "label": "Additional licences / certificates",
            "kind": "yesno",
            "group": "Technology",
            "options": [
                "Yes",
                "No"
            ],
            "description": "Additional software licences or SSL certificates are required."
        },
        "authentication": {
            "label": "Authenticated access",
            "kind": "yesno",
            "group": "Security and assurance",
            "options": [
                "Yes",
                "No"
            ],
            "description": "People sign in to access the service or information."
        },
        "privilegedAccess": {
            "label": "Privileged / administrative access",
            "kind": "yesno",
            "group": "Security and assurance",
            "options": [
                "Yes",
                "No"
            ],
            "description": "Elevated permissions exist for administrators, operators or deployment accounts."
        },
        "supplierAccess": {
            "label": "Supplier involvement",
            "kind": "yesno",
            "group": "Security and assurance",
            "options": [
                "Yes",
                "No"
            ],
            "description": "A supplier develops, hosts, supports or accesses the service or departmental systems."
        },
        "criticalService": {
            "label": "Business important / critical",
            "kind": "yesno",
            "group": "Security and assurance",
            "options": [
                "Yes",
                "No"
            ],
            "description": "The service supports critical operations or could cause significant disruption if unavailable."
        },
        "govAssureInScope": {
            "label": "GovAssure in scope",
            "kind": "yesno",
            "group": "Security and assurance",
            "options": [
                "Yes",
                "No"
            ],
            "description": "The service has been identified as in scope for GovAssure."
        },
        "staffInScope": {
            "label": "Staff in scope",
            "kind": "yesno",
            "group": "Security and assurance",
            "options": [
                "Yes",
                "No"
            ],
            "description": "Staff work on or operate the service and need security-awareness training."
        },
        "activities": {
            "label": "Activities underway",
            "kind": "multi",
            "group": "Security and assurance",
            "options": [
                "Business case",
                "Economic appraisal",
                "Security assessment",
                "Threat modelling",
                "Control selection",
                "Control implementation",
                "Service change",
                "Asset retirement",
                "Security tooling procurement",
                "Risk acceptance",
                "Security incident",
                "Early life support"
            ],
            "description": "Current delivery and assurance activities; these are applicability facts, not claims that a requirement has been completed."
        },
        "riskFactors": {
            "label": "Known risk factors",
            "kind": "multi",
            "group": "Security and assurance",
            "options": [
                "Above risk appetite",
                "Residual risk",
                "End-of-life software"
            ],
            "description": "Known risk findings that trigger escalation, treatment or remediation obligations."
        },
        "controlsImplemented": {
            "label": "Security controls implemented",
            "kind": "yesno",
            "group": "Security and assurance",
            "options": [
                "Yes",
                "No"
            ],
            "description": "Controls have been built or configured and can now be tested or reassessed."
        },
        "threatsIdentified": {
            "label": "Threats identified",
            "kind": "yesno",
            "group": "Security and assurance",
            "options": [
                "Yes",
                "No"
            ],
            "description": "Credible threats have been identified and controls need to be mapped against them."
        },
        "backups": {
            "label": "Data backed up",
            "kind": "yesno",
            "group": "Security and assurance",
            "options": [
                "Yes",
                "No"
            ],
            "description": "A backup exists whose restoration capability must be tested."
        }
    },
    "scopes": [
        {
            "ids": "101,106,112,113,120,121,125,126,127,130,131,135,136,139,141,144,145,146,164,165,191,195,199,200,203,204,205,206,207,208,209,210,211,212,214,215,220,221,225,230,231,232,233,234,235,236,237,238,239,240,243,245,246,247,248,249,250,251,258,259,264,265,266",
            "note": "Applies to an in-scope service at the recorded delivery stages. Source guidance about how to perform the activity is not an additional applicability gate."
        },
        {
            "ids": "102,103",
            "any": [
                [
                    "hasUsers",
                    "is",
                    "Yes"
                ],
                [
                    "channel",
                    "includes",
                    "Online"
                ]
            ],
            "note": "Prototype interpretation: accessibility and statement enrolment apply to user-facing services, not headless components. Confirm the scope with the accessibility owner."
        },
        {
            "ids": "104",
            "all": [
                [
                    "deliveryModel",
                    "in",
                    [
                        "In-house",
                        "Hybrid"
                    ]
                ]
            ],
            "any": [
                [
                    "changeType",
